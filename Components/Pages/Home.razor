@code {
    private string currentTheme = "theme-dark";
    private bool isGameStarted = false;
    
    private int playerHP = 100;
    private int enemyHP = 100;
    private int knightScore = 0;
    private int skeletonScore = 0;
    private int playerX = 150;
    private int enemyX = 1000;
    
    private string playerPose = "Idle";
    private string enemyPose = "Idle";
    private string battleStatus = "intro-phase";
    private string lastMessage = "Cinematic Intro Active... Prepare yourself!";
    
    private bool isPaused = false;
    private bool isRoundOver = false;
    private bool isTournamentWon = false;
    private bool showIntro = true;
    private string roundOverMessage = "";
    private int currentRound = 1;
    private int fireballX = 1000;
    private bool isFireballActive = false;
    private bool isRunning = false;
    private bool showSettings = false;

    // Theme Colors
    private string skyColorTop = "#020617";
    private string skyColorMid = "#0f172a";
    private string skyColorBot = "#1e1b4b";
    private string cloudColor1 = "#312e81";
    private string cloudColor2 = "#4338ca";
    private string mountainColorTop = "#111827";
    private string mountainColorBot = "#1f2937";
    private string mountainFrontColor = "#111827";
    private string groundColorTop = "#020617";
    private string groundColorBot = "#0f172a";
    private string gridLineColor = "#38bdf8";

    // HRE ENGINE KA REAL TIMER FIXED
    private System.Timers.Timer? gameLoopTimer;

    private void StartMatchArena(int targetRound)
    {
        // Purane chalte hue timer ko saaf karo pehle
        gameLoopTimer?.Stop();
        gameLoopTimer?.Dispose();

        currentRound = targetRound;
        isGameStarted = true;
        showIntro = true;
        isRoundOver = false;
        playerHP = 100;
        enemyHP = 100;
        playerX = 150;
        enemyX = 1000;
        playerPose = "Idle";
        enemyPose = "Idle";
        
        if (currentRound == 2)
        {
            isFireballActive = true;
            fireballX = 1000;
            lastMessage = "Level 2 Initiated: Fireball Evasion Sequence Active!";
        }
        else
        {
            isFireballActive = false;
            lastMessage = "Level 1 Initiated: Melee Combat Stance Engaged.";
        }

        // Auto hide intro overlay after 2 seconds
        var introTimer = new System.Timers.Timer(2000);
        introTimer.Elapsed += (s, e) =>
        {
            showIntro = false;
            introTimer.Stop();
            introTimer.Dispose();
            
            // INTRO KHATAM HOTAY HI GAME LOOP ENGINE START
            StartGameLoop();
            InvokeAsync(StateHasChanged);
        };
        introTimer.Start();
    }

    // NAYA FUNCTION: Jo Game Engine Loop ko har 50ms baad chalaye ga
    private void StartGameLoop()
    {
        gameLoopTimer = new System.Timers.Timer(50); // 50 milliseconds tick speed
        gameLoopTimer.Elapsed += OnGameTick;
        gameLoopTimer.AutoReset = true;
        gameLoopTimer.Start();
    }

    // NAYA FUNCTION: Jahan Skeleton ki Fight AI aur Fireball ki movement real-time calculate hogi
    private void OnGameTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!isGameStarted || showIntro || isRoundOver || isPaused) return;

        InvokeAsync(() =>
        {
            int distance = Math.Abs(playerX - enemyX);

            // --- ROUND 1 SKELETON AI ---
            if (currentRound == 1)
            {
                if (distance > 90)
                {
                    enemyX -= 5; // Skeleton Knight ki taraf barhega
                    enemyPose = "Idle";
                }
                else
                {
                    // Range me aate hi skeleton attack karega
                    enemyPose = "Attack";
                    
                    if (playerPose != "Shield" && playerPose != "Hit")
                    {
                        playerHP = Math.Max(0, playerHP - 2); // Player damage layer
                        playerPose = "Hit";
                        lastMessage = "Skeleton deals damage! Use Shield [W]!";
                        
                        if (playerHP <= 0) HandleRoundLoss();
                        
                        // Hit stance reset delay
                        Task.Delay(300).ContinueWith(_ => { if (playerPose == "Hit") playerPose = "Idle"; InvokeAsync(StateHasChanged); });
                    }
                    else if (playerPose == "Shield")
                    {
                        lastMessage = "Attack Blocked successfully!";
                    }
                }
            }

            // --- ROUND 2 FIREBALL TRACKER ---
            if (currentRound == 2)
            {
                if (isFireballActive)
                {
                    enemyPose = "Attack";
                    fireballX -= 25; // Fireball left side pe slide karegi fastly

                    // Fireball hits player detection
                    if (Math.Abs(fireballX - playerX) < 40)
                    {
                        isFireballActive = false; // Reset object
                        
                        if (playerPose == "Shield")
                        {
                            knightScore += 100;
                            lastMessage = "Fireball Blocked! +100 Points.";
                        }
                        else
                        {
                            playerHP = Math.Max(0, playerHP - 20);
                            playerPose = "Hit";
                            lastMessage = "Ouch! Fireball hit you! -20 HP.";
                            if (playerHP <= 0) HandleRoundLoss();
                            
                            Task.Delay(300).ContinueWith(_ => { if (playerPose == "Hit") playerPose = "Idle"; InvokeAsync(StateHasChanged); });
                        }
                        
                        // Nayi fireball respawn timer setup automatically
                        RespawnFireball();
                    }
                    else if (fireballX < 0) // Screen se baahir nikal gayi agar
                    {
                        isFireballActive = false;
                        RespawnFireball();
                    }
                }
            }

            StateHasChanged();
        });
    }

    private void RespawnFireball()
    {
        Task.Delay(1000).ContinueWith(_ =>
        {
            if (isGameStarted && !isRoundOver)
            {
                fireballX = enemyX - 40;
                isFireballActive = true;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private void HandleRoundLoss()
    {
        isRoundOver = true;
        gameLoopTimer?.Stop();
        roundOverMessage = "GAME OVER! Dark Magic Defeated You.";
    }

    private void ResetDashboardLayout()
    {
        gameLoopTimer?.Stop();
        isGameStarted = false;
        isRoundOver = false;
        isFireballActive = false;
        currentRound = 1;
        playerHP = 100;
        enemyHP = 100;
        lastMessage = "Dashboard Re-initialized. Choose a Level.";
    }

    private void ToggleSettings() => showSettings = !showSettings;

    private void ChangeTheme(string theme)
    {
        currentTheme = theme;
        if (theme == "theme-light")
        {
            skyColorTop = "#bae6fd"; skyColorMid = "#7dd3fc"; skyColorBot = "#38bdf8";
            groundColorTop = "#e2e8f0"; groundColorBot = "#cbd5e1"; gridLineColor = "#0284c7";
        }
        else
        {
            skyColorTop = "#020617"; skyColorMid = "#0f172a"; skyColorBot = "#1e1b4b";
            groundColorTop = "#020617"; groundColorBot = "#0f172a"; gridLineColor = "#38bdf8";
        }
    }

    private void ToggleRun() => isRunning = !isRunning;
    private void MoveForward() => playerX = Math.Min(1100, playerX + (isRunning ? 40 : 20));
    private void MoveBackward() => playerX = Math.Max(50, playerX - (isRunning ? 40 : 20));

    private void TriggerShield()
    {
        playerPose = "Shield";
        lastMessage = "Knight is blocking attacks!";
        Task.Delay(800).ContinueWith(_ =>
        {
            if (playerPose == "Shield") playerPose = "Idle";
            InvokeAsync(StateHasChanged);
        });
    }

    private void TriggerAttack()
    {
        if (playerPose == "Hit") return;
        playerPose = "Attack";
        
        if (Math.Abs(playerX - enemyX) < 120 && currentRound == 1)
        {
            enemyHP = Math.Max(0, enemyHP - 15);
            knightScore += 50;
            lastMessage = "Hit Successful! Enemy HP Reduced.";
            if (enemyHP <= 0) HandleRoundWin();
        }
        else if (currentRound == 2)
        {
            lastMessage = "Fire Mage is too far! Just Survive and Block!";
        }
        else
        {
            lastMessage = "Attack missed! Move closer to the target.";
        }

        Task.Delay(400).ContinueWith(_ =>
        {
            if (playerPose == "Attack") playerPose = "Idle";
            InvokeAsync(StateHasChanged);
        });
    }

    private void HandleRoundWin()
    {
        isRoundOver = true;
        gameLoopTimer?.Stop();
        roundOverMessage = currentRound == 1 ? "ROUND 1 CLEAR! Gatekeeper Defeated." : "VICTORY! Tournament Won.";
    }

    private void ProceedToNextMatchState()
    {
        if (currentRound == 1)
        {
            StartMatchArena(2);
        }
        else
        {
            ResetDashboardLayout();
        }
    }

    private void HandleKeyPress(KeyboardEventArgs e)
    {
        if (!isGameStarted || showIntro || isRoundOver) return;
        switch (e.Key)
        {
            case "ArrowRight": MoveForward(); break;
            case "ArrowLeft": MoveBackward(); break;
            case "Shift": ToggleRun(); break;
            case "w": case "W": TriggerShield(); break;
            case " ": TriggerAttack(); break;
        }
    }

    public void Dispose()
    {
        gameLoopTimer?.Stop();
        gameLoopTimer?.Dispose();
    }
} *@


